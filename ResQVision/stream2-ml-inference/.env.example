# ─────────────────────────────────────────────────────────────────────────────
# ResQVision — Stream 2: ML Inference & Satellite Orchestration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Run mode ─────────────────────────────────────────────────────────────────
# Set to "true" to skip satellite fetch + PyTorch and use synthetic outputs.
# This is the DEFAULT and the mode used for demos/development.
# Set to "false" only when a trained model checkpoint exists AND CDSE
# credentials are configured below.
MOCK_INFERENCE=true

# ── Inter-stream routing ──────────────────────────────────────────────────────
# URL of Stream 3's assessment intake endpoint.
# Change host/port to match your deployment (Docker network, k8s service, etc.)
STREAM3_ASSESSMENT_URL=http://localhost:8003/api/assessments

# ── Server config ─────────────────────────────────────────────────────────────
PORT=8002
LOG_LEVEL=INFO

# ── Copernicus Data Space Ecosystem (CDSE) ────────────────────────────────────
# Register at: https://dataspace.copernicus.eu/
# After registration, create an OAuth2 client in your account dashboard.
# Required for MOCK_INFERENCE=false (satellite imagery acquisition).
CDSE_CLIENT_ID=your_cdse_oauth_client_id_here
CDSE_CLIENT_SECRET=your_cdse_oauth_client_secret_here

# ── WorldPop population data ──────────────────────────────────────────────────
# Optional: obtain from https://www.worldpop.org/
# If not set, population estimates fall back to a formula-based approximation.
WORLDPOP_API_KEY=

# ── Model checkpoint ──────────────────────────────────────────────────────────
# Path to the trained Siamese U-Net checkpoint (.pth file).
# Only used when MOCK_INFERENCE=false.
# Download xBD dataset from https://xview2.org/ (requires free registration)
# then run: python -m app.ml.train  to produce this file.
MODEL_CHECKPOINT_PATH=checkpoints/siamese_unet_best.pth

# ── Retry configuration ────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
RETRY_WAIT_SECONDS=2

# ── Satellite fetch tuning ─────────────────────────────────────────────────────
# Bounding box half-size in km around the event coordinates
BBOX_HALF_KM=5
# Maximum cloud cover % for Sentinel-2 optical imagery
MAX_CLOUD_COVER=20
# How often (hours) to retry fetching post-event imagery if not yet available
POST_IMAGE_POLL_INTERVAL_HOURS=2
# Maximum hours to wait for post-event imagery before giving up
POST_IMAGE_MAX_WAIT_HOURS=12
