# false = live (reads Stream 3). true = fake demo data for UI work only.
VITE_USE_MOCK_DATA=false

# External Stream 3 disaster assessment API target
VITE_STREAM3_BASE_URL=http://localhost:8003

# Local ResQVision Layer 3 backend server target
VITE_LAYER3_API_URL=http://127.0.0.1:8004

# Confirmed Stream 3 read contracts identified in the project brief
VITE_ACTIVE_DISASTERS_PATH=/api/active-disasters
VITE_DISPATCH_LOG_PATH=/api/assessments/:event_id/dispatch-log
