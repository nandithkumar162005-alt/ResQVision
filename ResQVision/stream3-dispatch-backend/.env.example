# ==============================================================================
# RESQVISION STREAM 3 — DISPATCH BACKEND & COMMUNICATIONS ENGINE CONFIGURATION
# ==============================================================================

# Database Connection URL
# For Supabase / Neon PostgreSQL (Production & Demo):
# postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# For local SQLite testing (Zero-setup development fallback):
# sqlite:///./disaster_dispatch.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqvision_dispatch

# Server Port and Host
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Public URL for NDRF verify callbacks (used in Telegram message links)
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# Telegram Bot Token (from @BotFather)
# If empty or set to "mock", messages will be logged to console and DB without live Telegram HTTP calls
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# Telegram Chat IDs for Dedicated Agency Channels
# Obtained by adding bot to each group and reading chat_id from getUpdates or @RawDataBot
TELEGRAM_CHAT_ID_NDRF=-1001234567891
TELEGRAM_CHAT_ID_MEDICAL=-1001234567892
TELEGRAM_CHAT_ID_POLICE=-1001234567893
TELEGRAM_CHAT_ID_FIRE=-1001234567894
TELEGRAM_CHAT_ID_COMMAND=-1001234567895
